// LaunchKit - 中文 SaaS Boilerplate
// Prisma Schema 定义

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 用户认证相关 ====================

// 用户表
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // 密码登录用
  phone         String?   @unique // 手机号登录用
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联
  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
  orders        Order[]

  @@map("users")
}

// 用户角色枚举
enum Role {
  USER
  ADMIN
}

// OAuth 账号（微信登录等）
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// 会话
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// 邮箱验证令牌
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==================== 订阅与支付相关 ====================

// 订阅计划
model Plan {
  id          String   @id @default(cuid())
  name        String   // 计划名称：基础版、专业版等
  description String?  // 计划描述
  price       Int      // 价格（分）
  interval    Interval @default(MONTH) // 计费周期
  features    String[] // 功能列表
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
  orders        Order[]

  @@map("plans")
}

// 计费周期枚举
enum Interval {
  MONTH
  YEAR
  LIFETIME
}

// 用户订阅
model Subscription {
  id                String             @id @default(cuid())
  userId            String
  planId            String
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean           @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

// 订阅状态枚举
enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

// 订单
model Order {
  id            String      @id @default(cuid())
  orderNo       String      @unique // 订单号
  userId        String
  planId        String
  amount        Int         // 金额（分）
  status        OrderStatus @default(PENDING)
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  tradeNo       String?     // 第三方交易号（支付宝/微信）
  metadata      Json?       // 额外信息
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@map("orders")
}

// 订单状态枚举
enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

// 支付方式枚举
enum PaymentMethod {
  ALIPAY
  WECHAT
}
